--------------------------------------------------------------------------------
-- Port state model
--------------------------------------------------------------------------------
function getPortState(port)
  state.ports[port] = state.ports[port] or {
    enabled        = true,
    link           = false,
    memberOf       = nil,
    poe            = nil,
    poeEnabled     = nil,
    rlinkx         = nil,
    speed          = nil,
    lastValidSpeed = nil,
    speedPending   = false,
  }
  return state.ports[port]
end

