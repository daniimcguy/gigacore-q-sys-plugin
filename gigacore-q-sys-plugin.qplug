--------------------------------------------------------------------------------
-- Internal state
--------------------------------------------------------------------------------
state = {
  ws              = nil,
  baseIP          = "",
  currentIP       = "",
  prefixLength    = "",
  ipMode          = "",
  portCount       = 30,
  macAddress      = "",
  firmwareVersion = "",
  groupNames      = {},
  groupMeta       = {},
  customColors    = {},   -- "Group: N" / "Trunk: N" → {r,g,b} (live from API)
  groupList       = {},   -- [{id, name, color, predefined, vid}] ordered as returned
  trunkList       = {},   -- [{id, name, color, predefined}] ordered as returned
  ports           = {},
  darkMode        = false,
}

--------------------------------------------------------------------------------
-- Port state model
--------------------------------------------------------------------------------
function getPortState(port)
  state.ports[port] = state.ports[port] or {
    enabled        = true,
    link           = false,
    memberOf       = nil,
    poe            = nil,
    poeEnabled     = nil,
    rlinkx         = nil,
    speed          = nil,
    lastValidSpeed = nil,
    speedPending   = false,
  }
  return state.ports[port]
end

