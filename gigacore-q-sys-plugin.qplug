--------------------------------------------------------------------------------
-- Static Tables / Lookups
--------------------------------------------------------------------------------
-- Per-model port type breakdown. Ports are assumed to be numbered
-- sequentially: ethercon → rj45 → sfp.
PORT_LAYOUT = {
  ["GigaCore 30i"]    = { ethercon = 0,  rj45 = 24, sfp = 6  },
  ["GigaCore S30-I"]  = { ethercon = 0,  rj45 = 24, sfp = 6  },
  ["GigaCore O26-I"]  = { ethercon = 0,  rj45 = 0,  sfp = 26 }, -- 2 QSFP + 4 SFP28 + 20 SFP+
  ["GigaCore 20t"]    = { ethercon = 8,  rj45 = 8,  sfp = 4  },
  ["GigaCore 18t"]    = { ethercon = 8,  rj45 = 6,  sfp = 2  },
  ["GigaCore 16t"]    = { ethercon = 8,  rj45 = 8,  sfp = 0  },
  ["GigaCore 16tf"]   = { ethercon = 12, rj45 = 0,  sfp = 4  },
  ["GigaCore 16i"]    = { ethercon = 0,  rj45 = 12, sfp = 4  },
  ["GigaCore 10t"]    = { ethercon = 8,  rj45 = 0,  sfp = 2  },
  ["GigaCore 10t-IP"] = { ethercon = 8,  rj45 = 0,  sfp = 2  },
  ["GigaCore 10i"]    = { ethercon = 0,  rj45 = 8,  sfp = 2  },
}

-- Build GigaCoreModels (port totals) from PORT_LAYOUT for backward compat.
GigaCoreModels = {}
for model, layout in pairs(PORT_LAYOUT) do
  GigaCoreModels[model] = (layout.ethercon or 0) + (layout.rj45 or 0) + (layout.sfp or 0)
end

function getPortCount(model)
  return GigaCoreModels[model] or 30
end

function getEtherconCount(model)
  local l = PORT_LAYOUT[model]
  return (l and l.ethercon) or 0
end

function getRJ45Count(model)
  local l = PORT_LAYOUT[model]
  return (l and l.rj45) or 0
end

function getSFPCount(model)
  local l = PORT_LAYOUT[model]
  return (l and l.sfp) or 0
end

-- Look up the base64-encoded chassis SVG for a given model.
MODEL_SVG = {
  ["GigaCore 10i"]    = function() return _G.Chassis10i   end,
  ["GigaCore 10t"]    = function() return _G.Chassis10t   end,
  ["GigaCore 10t-IP"] = function() return _G.Chassis10tIP end,
  ["GigaCore 16i"]    = function() return _G.Chassis16i   end,
  ["GigaCore 16t"]    = function() return _G.Chassis16t   end,
  ["GigaCore 16tf"]   = function() return _G.Chassis16tf  end,
  ["GigaCore 18t"]    = function() return _G.Chassis18t   end,
  ["GigaCore 20t"]    = function() return _G.Chassis20t   end,
  ["GigaCore 30i"]    = function() return _G.Chassis30i   end,
  ["GigaCore O26-I"]  = function() return _G.ChassisO26I  end,
  ["GigaCore S30-I"]  = function() return _G.ChassisS30I  end,
}

function getChassisSvg(model)
  local fn = MODEL_SVG[model]
  return fn and fn() or nil
end

-- Return the parsed PORT_COORDS entry for a model, or nil if we haven't
-- built an accurate overlay for it yet (fall back to the generic grid).
function getPortCoords(model)
  return PORT_COORDS and PORT_COORDS[model]
end

-- Translate a rect from SVG space (per the model's viewBox) to screen space
-- given where the SVG is rendered on the page.
function svgToScreen(coords, svgX, svgY, svgW, svgH, vbW, vbH)
  local sx = svgW / vbW
  local sy = svgH / vbH
  return {
    x = svgX + coords.x * sx,
    y = svgY + coords.y * sy,
    w = coords.w * sx,
    h = coords.h * sy,
  }
end

-- Resolve the model from the Model property (plain lookup).
function resolveModel(props)
  local raw = props["Model"]
  local val = (type(raw) == "table") and raw.Value or raw
  return val or "GigaCore 30i"
end

