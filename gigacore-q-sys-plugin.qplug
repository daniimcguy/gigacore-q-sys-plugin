    { port = 12, x = 81.085, y = 18.922, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 84.166, y = 24.007, w = 5.006, h = 5.006 } },
    { port = 13, x = 99.105, y = 8.911, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 102.186, y = 5.987, w = 5.006, h = 5.006 } },
    { port = 14, x = 99.105, y = 18.922, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 102.188, y = 24.007, w = 5.006, h = 5.006 } },
    { port = 15, x = 114.122, y = 8.911, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 117.205, y = 5.987, w = 5.006, h = 5.006 } },
    { port = 16, x = 114.122, y = 18.922, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 117.205, y = 24.007, w = 5.006, h = 5.006 } },
    { port = 17, x = 129.138, y = 8.911, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 132.221, y = 5.987, w = 5.006, h = 5.006 } },
    { port = 18, x = 129.138, y = 18.922, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 132.221, y = 24.007, w = 5.006, h = 5.006 } },
    { port = 19, x = 144.157, y = 8.911, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 147.238, y = 5.987, w = 5.006, h = 5.006 } },
    { port = 20, x = 144.157, y = 18.922, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 147.238, y = 24.007, w = 5.006, h = 5.006 } },
    { port = 21, x = 159.174, y = 8.911, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 162.255, y = 5.987, w = 5.006, h = 5.006 } },
    { port = 22, x = 159.174, y = 18.922, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 162.255, y = 24.007, w = 5.006, h = 5.006 } },
    { port = 23, x = 174.190, y = 8.911, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 177.273, y = 5.987, w = 5.006, h = 5.006 } },
    { port = 24, x = 174.190, y = 18.922, w = 11.170, h = 7.166, kind = "rj45", poe = { x = 177.273, y = 24.007, w = 5.006, h = 5.006 } },
    { port = 25, x = 197.526, y = 7.738, w = 12.982, h = 8.786, kind = "sfp" },
    { port = 26, x = 197.526, y = 18.476, w = 12.982, h = 8.786, kind = "sfp" },
    { port = 27, x = 213.502, y = 7.738, w = 12.982, h = 8.786, kind = "sfp" },
